# ══════════════════════════════════════════════════════════════════
#  Üretim ortam değişkenleri — sunucuda repo köküne `.env` olarak kopyalanır
# ══════════════════════════════════════════════════════════════════
#
#     cp deploy/.env.example .env
#
# ⚠️ Bu dosya HEM docker-compose.yml'in kendi değişken doldurması
# (${DOMAIN} gibi) HEM DE api konteynerine enjekte edilen gerçek ortam
# değişkenleri için kullanılıyor — tek dosya, iki iş.

# ─── Domain ────────────────────────────────────────────────────
# Caddy bunların HER İKİSİ için de otomatik HTTPS sertifikası alır.
#
# DOMAIN       → müşterilerin randevu aldığı site
# PANEL_DOMAIN → berberlerin kullandığı panel
#
# ⚠️ PANEL_DOMAIN için Natro'da A kaydı OLMAK ZORUNDA:
#       Tip: A   Ad: panel   Değer: <sunucu IP>
#    Kayıt yoksa Caddy o alan adı için sertifika alamaz ve panel açılmaz.
DOMAIN=ozdedehairstudio.com
PANEL_DOMAIN=panel.ozdedehairstudio.com

# ─── Genel ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ─── Veritabanı (Neon) ────────────────────────────────────────
DATABASE_URL="postgresql://kullanici:sifre@host/veritabani?sslmode=require"
DIRECT_DATABASE_URL="postgresql://kullanici:sifre@host/veritabani?sslmode=require"

# ─── CORS ───────────────────────────────────────────────────────
# Her iki ön yüz de KENDİ adresindeki /api'yi çağırıyor (Caddy ikisinde de
# aynı arka uca yönlendiriyor), dolayısıyla tarayıcı açısından istekler
# zaten aynı origin'e gidiyor ve CORS normal koşulda hiç devreye girmiyor.
# Yine de ikinci savunma katmanı olarak iki adres de yazılı.
CORS_ORIGIN=https://ozdedehairstudio.com,https://panel.ozdedehairstudio.com

# ─── Herkese açık site hangi dükkana ait? ─────────────────────
# Tek aktif dükkan varsa BOŞ bırakılabilir — otomatik ona düşer.
# Birden fazla aktif dükkan olursa zorunlu hale gelir.
PUBLIC_SHOP_ID=

# ─── Kimlik doğrulama ─────────────────────────────────────────
# Geliştirmedeki JWT_ACCESS_SECRET'i BURAYA KOPYALAMA — üretim için
# yeni ve farklı bir tane üret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ─── WhatsApp Cloud API ───────────────────────────────────────
# ⚠️ BİLİNÇLİ OLARAK BOŞ BIRAKILDI. Yol haritası gereği: önce sunucu ve
# panel WhatsApp'sız olarak yayına alınıp doğrulanır, WhatsApp EN SON
# adımda bağlanır. Bu alanlar boşken sistem normal çalışır, bot yalnızca
# sahte istemcide kalır (gerçek mesaj gönderilmez/alınmaz).
#
# Meta hesabı hazır olduğunda buraya girilecek 4 değer — o ana kadar
# dokunma:
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# ─── Hata takibi (opsiyonel ama üretimde önerilir) ────────────
#
# sentry.io'da ücretsiz hesap açıp bir Node.js projesi oluşturun; verilen
# DSN adresini buraya yapıştırın. BOŞ BIRAKILIRSA hata izleme sessizce
# devre dışı kalır — uygulama normal çalışmaya devam eder.
# Telefon numaraları ve şifreler Sentry'ye GÖNDERİLMEZ (lib/sentry.ts).
SENTRY_DSN=

# KVKK aydınlatma metnindeki iletişim adresi.
LEGAL_CONTACT_EMAIL=

# Dükkan telefonu. YALNIZCA "sunucuya ulaşılamıyor" hata ekranındaki
# "Bizi arayın" bağlantısında kullanılır; siteye derleme sırasında gömülür,
# bu yüzden değiştiğinde caddy imajının yeniden derlenmesi gerekir.
CONTACT_PHONE=
