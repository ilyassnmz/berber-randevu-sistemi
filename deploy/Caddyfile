# ══════════════════════════════════════════════════════════════════
#  Caddy yapılandırması
# ══════════════════════════════════════════════════════════════════
#
# İKİ ayrı site:
#
#   {$DOMAIN}        ozdedehairstudio.com        → müşteri randevu sitesi
#   {$PANEL_DOMAIN}  panel.ozdedehairstudio.com  → berber paneli
#
# İkisinde de /api aynı arka uca gidiyor. Bu bilinçli: her ön yüz KENDİ
# adresindeki /api'yi çağırıyor, dolayısıyla tarayıcı açısından istekler
# aynı origin'e gidiyor ve CORS hiç devreye girmiyor. Ayrı bir api.* alan
# adı açılsaydı iki ön yüz için de CORS ve çerez ayarı gerekirdi.
#
# ⚠️ Alt alan adı için Natro'da A kaydı gerekiyor:
#     Tip: A   Ad: panel   Değer: <sunucu IP>
# Kayıt yoksa Caddy o alan adı için sertifika ALAMAZ ve panel açılmaz.
#
# ⚠️ acme_ca elle production'a sabitlendi: DNS yanlış hedefi gösterdiği
# dönemde production'a yapılan denemeler başarısız olunca Caddy kendiliğinden
# staging (test) ortamına düşmüştü — staging sertifikaları tarayıcılar
# tarafından güvenilmez. Bu satır olmadan Caddy bir daha aynı duruma düşerse
# fark edilmeden staging'de takılı kalabilir.
{
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

# ─── Ortak tanımlar ───────────────────────────────────────────────
#
# API yönlendirmesi iki sitede de birebir aynı; tek yerde tutuluyor ki
# biri değişip diğeri unutulmasın.
(api_routes) {
	handle /api/* {
		reverse_proxy api:3000
	}
	handle /healthz {
		reverse_proxy api:3000
	}
	handle /readyz {
		reverse_proxy api:3000
	}
}

# Tek sayfa uygulaması sunumu. Argüman: kök dizin.
#     import spa_site /srv/web
(spa_site) {
	root * {args[0]}
	encode gzip

	header {
		# Ön yüz varlıkları içerik-adresli (Vite dosya adına hash koyuyor),
		# bu yüzden uzun süre önbelleklenebilir.
		?Cache-Control "public, max-age=3600"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# index.html ASLA önbelleklenmemeli: yeni sürüm yayınlandığında
	# tarayıcı eski index'i tutarsa, artık var olmayan hash'li dosyaları
	# istemeye devam eder ve site beyaz ekrana düşer.
	@html path /index.html /
	header @html Cache-Control "no-cache"

	# Service worker da önbelleklenmemeli — güncellenmesi gereken İLK şey o.
	@sw path /sw.js
	header @sw Cache-Control "no-cache"

	# ⚠️ Uzantılı dosyalar index.html'e DÜŞMEZ.
	#
	# Eskiden tek bir `try_files {path} /index.html` vardı ve olmayan HER
	# dosya için 200 + HTML dönüyordu. Bu, gerçek bir arızaya yol açtı:
	# kök adres eskiden panel PWA'sını sunuyordu, tarayıcılarda o PWA'nın
	# service worker'ı kayıtlı kaldı. Service worker kendini güncellemek
	# için /sw.js isteyince JavaScript yerine HTML aldı, güncelleme sessizce
	# başarısız oldu ve ziyaretçiler yeni site yayına alındıktan sonra bile
	# önbellekteki ESKİ paneli görmeye devam etti.
	#
	# Artık olmayan bir varlık düzgünce 404 dönüyor: hata görünür oluyor,
	# sessizce yanlış içerik sunulmuyor.
	@asset path *.js *.mjs *.css *.map *.json *.webmanifest *.txt *.xml *.png *.jpg *.jpeg *.svg *.ico *.gif *.webp *.woff *.woff2 *.ttf
	handle @asset {
		file_server
	}

	# Geri kalan her şey (gezinme istekleri) index.html'e düşer —
	# /randevu/<anahtar> gibi adresler React Router'a devredilsin diye.
	handle {
		try_files {path} /index.html
		file_server
	}
}

# ══════════════════════════════════════════════════════════════════
#  Müşteri randevu sitesi
# ══════════════════════════════════════════════════════════════════
{$DOMAIN} {
	import api_routes

	# WhatsApp webhook'u yalnızca ana alan adında. Cloud API şu an
	# kullanılmıyor (bkz. DURUM.md) ama uç duruyor — ileride bir numara
	# bağlanırsa Meta'ya verilecek adres değişmesin.
	handle /webhook/* {
		reverse_proxy api:3000
	}

	# Gizlilik politikası — herkese açık, KVKK için gerekli.
	handle /gizlilik {
		reverse_proxy api:3000
	}

	import spa_site /srv/web

	log {
		output stdout
		format json
	}
}

# ══════════════════════════════════════════════════════════════════
#  Berber paneli
# ══════════════════════════════════════════════════════════════════
{$PANEL_DOMAIN} {
	import api_routes

	import spa_site /srv/panel

	log {
		output stdout
		format json
	}
}
