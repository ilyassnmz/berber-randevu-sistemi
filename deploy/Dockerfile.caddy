# ══════════════════════════════════════════════════════════════════
#  Panel + Caddy imajı
# ══════════════════════════════════════════════════════════════════
#
# Panel burada Docker İÇİNDE derlenir (host'ta elle `npm run build`
# çalıştırıp dosya kopyalamaya güvenmek yerine) — böylece deploy tek
# komutla, insan hatasına yer bırakmadan tekrarlanabilir.
#
# Repo kökünden çalıştırılmalı:
#
#     docker build -f deploy/Dockerfile.caddy -t ozdede-caddy .

FROM node:20-slim AS build

WORKDIR /app

# ⚠️ tsconfig.base.json dahil: panel ve shared'ın tsconfig'leri bunu
# "../../tsconfig.base.json" olarak extend ediyor.
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/panel/package.json apps/panel/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci

COPY packages/shared packages/shared
COPY apps/panel apps/panel

RUN npm run build --workspace=@berber/shared \
    && npm run build --workspace=@berber/panel

# ─────────────────────────────────────────────────────────

FROM caddy:2-alpine

# ⚠️ Bu imaj (API imajının aksine) BİLEREK root ile çalışıyor: 80 ve 443
# ayrıcalıklı portlar, root olmadan bind edilemez. Bunu kaldırmanın yolu
# (setcap ya da host'ta 8080/8443'e yönlendirip Docker'a taşıtmak) docker-
# compose.yml'e de dokunmayı gerektirir — tek dükkanlı, güvenilir bir imajdan
# (resmi Caddy) gelen bu risk, ekstra karmaşıklığa değmiyor.
COPY --from=build /app/apps/panel/dist /srv/panel
COPY deploy/Caddyfile /etc/caddy/Caddyfile
