# ══════════════════════════════════════════════════════════════
#  Özdede Hair Studio — Ortam Değişkenleri
# ══════════════════════════════════════════════════════════════
#
#  Bu dosyayı `.env` olarak kopyalayın ve doldurun:
#      cp .env.example .env
#
#  ⚠️ `.env` dosyası ASLA git'e eklenmez (.gitignore'da).
#     Gerçek şifre ve anahtarlar sadece orada durur.

# ─── Genel ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ─── Veritabanı ───────────────────────────────────────────────
# Neon kullanıyorsanız: neon.tech → proje → Connection String
# Havuzlanmış (pooled) bağlantı uygulama için, doğrudan bağlantı migration için.
DATABASE_URL="postgresql://kullanici:sifre@host/veritabani?sslmode=require"
DIRECT_DATABASE_URL="postgresql://kullanici:sifre@host/veritabani?sslmode=require"

# ─── Panel adresi (CORS) ──────────────────────────────────────
# Birden fazla adres virgülle ayrılır.
CORS_ORIGIN=http://localhost:5173

# ─── Kimlik doğrulama ─────────────────────────────────────────
# Üretmek için:  openssl rand -base64 48
# (Windows'ta: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_ACCESS_SECRET=buraya-en-az-32-karakterlik-rastgele-bir-anahtar-gelecek
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ─── WhatsApp Cloud API ───────────────────────────────────────
# Geliştirme sırasında boş bırakılabilir — bot devre dışı çalışır.
# Üretimde ZORUNLUdur (uygulama açılışta kontrol eder).
#
# Nereden alınır: developers.facebook.com → App → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Meta App Secret — App → Settings → Basic → App Secret
# ⚠️ Webhook imzasını doğrulamak için kullanılır. Bu olmadan webhook'a
#    herkes sahte müşteri mesajı gönderip randevu oluşturabilir.
WHATSAPP_APP_SECRET=

# Kendi belirlediğiniz rastgele bir metin. Meta'nın webhook kurulum
# ekranına da aynısı girilir; Meta GET isteğinde bunu geri gönderir.
WHATSAPP_VERIFY_TOKEN=

WHATSAPP_API_VERSION=v21.0

# ─── Hata takibi (opsiyonel) ──────────────────────────────────
#
# sentry.io'da ücretsiz hesap açıp bir Node.js projesi oluşturun; verilen
# DSN adresini buraya yapıştırın. BOŞ BIRAKILIRSA hata izleme sessizce
# devre dışı kalır — uygulama normal çalışmaya devam eder.
# Telefon numaraları ve şifreler Sentry'ye GÖNDERİLMEZ (lib/sentry.ts).
SENTRY_DSN=
